#!/bin/sh
#
# E5M-CK S55klipper_service — replaces the stock Creality init script.
#
# Differences from stock:
#   - Points PY_SCRIPT at our mainline Klipper install at
#     /usr/data/e5m-ck/klipper (instead of the read-only /usr/share/klipper).
#   - REUSES the stock Creality Python venv (/usr/share/klippy-env). We do
#     this because the stock venv ships pre-built greenlet + cffi for the
#     Ingenic MIPS SoC, and we don't want to install gcc on the printer
#     just to compile those (~100 MB on the small overlay partition).
#   - Drops the stock `copy_config` / `update_config` / `pcba_test` logic.
#     Our config is the source of truth and is managed by scripts/sync.sh
#     from the local repo. No auto-rollback to factory templates.
#   - Keeps `mcu_reset` so the klipper_mcu host process is restarted in lockstep.
#
# Rollback to stock klippy: factory-reset.sh restores
# /etc/init.d/S55klipper_service from /usr/data/backup/klipper-stock/.
#

USER_DATA=/usr/data
PROG=/usr/share/klippy-env/bin/python3
PY_SCRIPT=/usr/data/e5m-ck/klipper/klippy/klippy.py
PRINTER_DATA_DIR=$USER_DATA/printer_data
PRINTER_CONFIG_DIR=$PRINTER_DATA_DIR/config
PRINTER_LOGS_DIR=$PRINTER_DATA_DIR/logs
GCODE_FILES_DIR=$PRINTER_DATA_DIR/gcodes
PID_FILE=/var/run/klippy.pid

mcu_reset() {
    [ -z "$(pidof klipper_mcu)" ] || /etc/init.d/S57klipper_mcu restart
}

start() {
    if [ ! -x "$PROG" ]; then
        echo "ERROR: $PROG missing. The stock Creality venv has been wiped." >&2
        exit 1
    fi
    if [ ! -f "$PY_SCRIPT" ]; then
        echo "ERROR: $PY_SCRIPT missing. Run installs/install_klipper.sh first." >&2
        exit 1
    fi
    if [ ! -f "$PRINTER_CONFIG_DIR/printer.cfg" ]; then
        echo "ERROR: $PRINTER_CONFIG_DIR/printer.cfg missing. Run scripts/sync.sh --apply first." >&2
        exit 1
    fi

    mcu_reset

    mkdir -p "$PRINTER_DATA_DIR" "$PRINTER_CONFIG_DIR" "$PRINTER_LOGS_DIR" "$GCODE_FILES_DIR"

    HOME=/root start-stop-daemon -S -q -b -m -p "$PID_FILE" \
        --exec "$PROG" -- "$PY_SCRIPT" \
        "$PRINTER_CONFIG_DIR/printer.cfg" \
        -l "$PRINTER_LOGS_DIR/klippy.log" \
        -a /tmp/klippy_uds
}

stop() {
    start-stop-daemon -K -q -p "$PID_FILE"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
