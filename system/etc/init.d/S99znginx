#!/bin/sh
#
# /etc/init.d/S99znginx — Entware nginx serving Fluidd + Moonraker reverse proxy.
#
# Named S99z so it runs AFTER S99start_app, in case that script is still
# present and respawns web-server. As of the May 2026 refactor, the
# expected steady state is that creality_kill.sh --permanent has already
# moved S99start_app out and the Creality stock services don't start
# anymore. We still defensively check port 80 here so a partial install
# (Phase 4 deployed, creality_kill not yet run) fails loud rather than
# silently breaking the web UI.

NGINX=/opt/sbin/nginx
NGINX_CONF=/opt/etc/nginx/nginx.conf
PID_FILE=/var/run/nginx-e5m.pid

start() {
    if [ ! -x "$NGINX" ]; then
        echo "ERROR: $NGINX missing. opkg install nginx-ssl ?" >&2
        exit 1
    fi
    if [ ! -f "$NGINX_CONF" ]; then
        echo "ERROR: $NGINX_CONF missing. Run scripts/sync.sh --apply first." >&2
        exit 1
    fi

    # Verify port 80 is free. If Creality's web-server is still up, the
    # operator forgot to run creality_kill.sh --permanent. Refuse rather
    # than reach in and kill — that ownership lives in creality_kill.sh now.
    if pidof web-server >/dev/null 2>&1; then
        echo "ERROR: /usr/bin/web-server is still running on port 80." >&2
        echo "Run from your local machine:" >&2
        echo "  cat installs/creality_kill.sh | ssh root@printer 'sh -s -- --permanent'" >&2
        echo "Then retry: /etc/init.d/S99znginx start" >&2
        exit 1
    fi

    echo "Starting nginx with $NGINX_CONF ..."
    "$NGINX" -c "$NGINX_CONF" -t 2>&1 || {
        echo "ERROR: nginx config test failed." >&2
        exit 1
    }
    "$NGINX" -c "$NGINX_CONF"
    # nginx daemonizes itself; PID goes to $PID_FILE per our config.
}

stop() {
    if [ -f "$PID_FILE" ]; then
        kill -TERM "$(cat $PID_FILE)" 2>/dev/null
        rm -f "$PID_FILE"
    fi
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart|reload) restart ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit $?
