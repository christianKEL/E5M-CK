#!/bin/sh
#
# /etc/init.d/S56moonraker_service — Moonraker host process for Klipper.
#
# Sits between Klipper's UDS socket (/tmp/klippy_uds) and our web stack
# (nginx + Fluidd). Listens on TCP 7125 for HTTP/WebSocket clients.
#

PROG=/usr/data/venvs/moonraker/bin/python3
MOONRAKER_ROOT=/usr/data/e5m-ck/moonraker
DATA_PATH=/usr/data/printer_data
CONFIG="$DATA_PATH/config/moonraker.conf"
LOG_FILE="$DATA_PATH/logs/moonraker.log"
PID_FILE=/var/run/moonraker.pid

# Upload staging dir. Moonraker uses Tornado, which streams uploads via
# Python's tempfile (TMPDIR or /tmp by default). On this printer /tmp is
# tmpfs (RAM, 98 MB), so any upload bigger than ~95 MB blows up.
# /usr/data/mr_tmp lives on the 6 GB eMMC partition.
UPLOAD_TMP=/usr/data/mr_tmp

start() {
    if [ ! -x "$PROG" ]; then
        echo "ERROR: $PROG missing. Run install_moonraker.sh first." >&2
        exit 1
    fi
    if [ ! -f "$MOONRAKER_ROOT/moonraker/server.py" ]; then
        echo "ERROR: Moonraker source not installed at $MOONRAKER_ROOT." >&2
        exit 1
    fi
    if [ ! -f "$CONFIG" ]; then
        echo "ERROR: $CONFIG missing. Run scripts/sync.sh --apply first." >&2
        exit 1
    fi

    # Ensure the standard Klipper data layout exists.
    mkdir -p "$DATA_PATH/config" "$DATA_PATH/logs" "$DATA_PATH/gcodes" \
             "$DATA_PATH/database" "$DATA_PATH/comms" "$DATA_PATH/certs" \
             "$UPLOAD_TMP"

    # Moonraker uses relative imports (from . import ...) — must run as a
    # module (`python -m moonraker.server`), not as a script. PYTHONPATH
    # makes `moonraker` importable from the cloned source dir.
    # -d sets the data path (Moonraker writes db, jobs, comms socket there).
    # -c overrides the default $DATA_PATH/config/moonraker.conf lookup.
    # `python -m moonraker` runs moonraker/__main__.py which calls
    # server.main(). Note: `-m moonraker.server` does NOT work because
    # server.py is missing an `if __name__ == "__main__"` block in v0.10.0.
    # TMPDIR routes Tornado's upload-staging tempfile away from the
    # 98 MB tmpfs at /tmp; without this, Fluidd uploads >95 MB fail.
    HOME=/root PYTHONPATH="$MOONRAKER_ROOT" TMPDIR="$UPLOAD_TMP" \
        start-stop-daemon -S -q -b -m -p "$PID_FILE" \
        --exec "$PROG" -- -m moonraker \
        -d "$DATA_PATH" \
        -c "$CONFIG" \
        -l "$LOG_FILE"
}

stop() {
    start-stop-daemon -K -q -p "$PID_FILE"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart|reload) restart ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit $?
